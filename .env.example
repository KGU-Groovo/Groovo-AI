# 아래 값을 채워서 프로젝트 루트에 .env 파일로 저장하세요.
# JWT_SECRET은 Spring Boot와 반드시 동일한 값이어야 합니다.
# ENVIRONMENT=production일 때 JWT_SECRET이 기본값이면 서버가 시작을 거부합니다.

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-shared-with-spring-boot
# ws_token 서명 알고리즘. Spring Boot(JwtProvider)가 실제로 서명한 알고리즘과 반드시 같아야 합니다.
# BE는 jjwt Keys.hmacShaKeyFor(JWT_SECRET)로 키 길이에 따라 알고리즘을 자동 선택합니다:
#   JWT_SECRET 32~47바이트 → HS256, 48~63바이트 → HS384, 64바이트 이상 → HS512
# 값이 다르면 모든 WebSocket 연결이 4001(invalid token)로 거부됩니다. (기본값 HS256)
JWT_ALGORITHM=HS256
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=groovo-keypoints
# 개발/테스트 전용: true면 BE 세션 없이 /ws/analyze?reference_id=<곡 ID> 연결을 허용합니다.
# 데모/배포 기본값은 false (FE는 BE가 발급한 ws_url?token=ws_token으로 연결).
ENABLE_REFERENCE_ID_FALLBACK=false
# reference_id fallback용 곡 목록. 로컬 개발에서는 기본값(data/references/*.npy)을 사용하므로 생략할 수 있습니다.
# 배포에서 S3 기준 파일을 사용하려면 아래처럼 S3 key를 지정하세요.
# REFERENCE_KEYPOINTS={"hollywood-action":{"video_id":1,"keypoint_path":"refs/hollywood.npy","fps":30}}
DCA_CHECKPOINT_PATH=artifacts/training-ranking/checkpoints/best.pt
DCA_NORMALIZE_INPUT=true
