# 아래 값을 채워서 프로젝트 루트에 .env 파일로 저장하세요.
# JWT_SECRET은 Spring Boot와 반드시 동일한 값이어야 합니다.
# ENVIRONMENT=production일 때 JWT_SECRET이 기본값이면 서버가 시작을 거부합니다.

ENVIRONMENT=development
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-shared-with-spring-boot
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=groovo-keypoints
# 로컬 개발에서는 기본값(data/references/*.npy)을 사용하므로 생략할 수 있습니다.
# 배포에서 S3 기준 파일을 사용하려면 아래처럼 S3 key를 지정하세요.
# REFERENCE_KEYPOINTS={"hollywood-action":{"video_id":1,"keypoint_path":"refs/hollywood.npy","fps":30}}
DCA_CHECKPOINT_PATH=artifacts/training-ranking/checkpoints/best.pt
DCA_NORMALIZE_INPUT=true
